{
	"name": "danmi",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.7.0",
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@better-auth/api-key": "^1.7.2",
		"@better-auth/drizzle-adapter": "^1.7.2",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@vinext/cloudflare": "latest",
		"better-auth": "^1.7.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.39.0",
		"react": "latest",
		"react-dom": "latest",
		"react-server-dom-webpack": "latest",
		"shadcn": "^4.19.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"vinext": "latest",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "latest",
		"@tailwindcss/postcss": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"@vitejs/plugin-react": "latest",
		"@vitejs/plugin-rsc": "latest",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "latest",
		"tsx": "^4.23.13",
		"typescript": "latest",
		"vite": "latest",
		"wrangler": "latest"
	},
	"type": "module",
	"scripts": {
		"dev": "wrangler d1 migrations apply lark-auth-db --local && vinext dev",
		"build": "vinext build",
		"start": "wrangler dev --config dist/server/wrangler.json",
		"deploy": "pnpm run check && pnpm run db:migrate:remote && pnpm run build && vinext-cloudflare deploy --config dist/server/wrangler.json",
		"preview": "pnpm run build && pnpm run start",
		"test": "tsx test/verify-auth-mcp.ts && tsx test/verify-multi-mcp.ts && tsx test/verify-cookie-fix.ts",
		"check": "tsc --noEmit && drizzle-kit check && tsx test/verify-auth-mcp.ts && tsx test/verify-multi-mcp.ts && tsx test/verify-cookie-fix.ts",
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply lark-auth-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply lark-auth-db --remote",
		"db:check": "drizzle-kit check",
		"db:studio": "drizzle-kit studio",
		"mcp": "tsx src/mcp/stdio.ts"
	}
}